---
import { tracks } from '../data/learning';
import { pagePath } from '../lib/paths';
import { nav, site } from '../site.config';
import MusicToggle from './MusicToggle.astro';
import ThemeControls from './ThemeControls.astro';

const path = pagePath(Astro.url);
const inTrack = tracks.some((t) => path === `/${t.slug}`);

function isCurrent(href: string) {
  if (href === '/') return path === '';
  if (href === '/muc') return path === '/muc' || inTrack;
  return path === href;
}
---
<header class="site-header">
  <div class="masthead">
    <a class="monogram" href="/" aria-label="Trang chủ"><img src="/images/anh-thu/avatar.jpg" alt="" /></a>
    <div class="brand">
      <a class="logo" href="/">{site.title}</a>
      <span class="motto">{site.motto}</span>
      {site.mottoExtra && <span class="motto">{site.mottoExtra}</span>}
    </div>
    <div class="masthead-actions">
      <MusicToggle />
      <ThemeControls />
    </div>
  </div>
  <nav class="tabs" aria-label="Chính">
    {nav.map((n) => (
      <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
  </nav>
</header>
