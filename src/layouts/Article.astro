---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import { site } from '../site.config';

const { title, description, type = 'article' } = Astro.props as {
  title: string;
  description: string;
  type?: string;
};
---
<Base title={title} description={description} type={type}>
  <article>
    <header class="article-head">
      <h1>{title}</h1>
      <p class="article-subtitle">{description}</p>
      <div class="article-meta"><span class="article-author">{site.author}</span><slot name="meta" /></div>
    </header>
    <slot name="toc" />
    <div class="prose"><slot /></div>
    <slot name="after" />
  </article>
</Base>
