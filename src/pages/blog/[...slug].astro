---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getTrack } from '../../data/learning';
import { formatDate, getPosts, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---
<Article title={post.data.title} description={post.data.description}>
  <Fragment slot="meta">
    <a class="entry-track" href={`/${post.data.track}`}>{getTrack(post.data.track).title}</a>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{readingTime(post.body)} phút đọc</span>
    {post.data.tags.map((t) => <a href={`/tags/${t}`}>#{t}</a>)}
  </Fragment>
  {toc.length >= 3 && (
    <details class="toc" slot="toc">
      <summary>Mục lục</summary>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
  )}
  <Content />
</Article>
