---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import SectionHead from '../components/SectionHead.astro';
import { extraTracks, getTrack, levelTracks, projects } from '../data/learning';
import { formatDate, getEntries } from '../lib/content';
import { site } from '../site.config';

const entries = await getEntries();
const featured = entries.find((e) => e.featured) ?? entries[0];
const latest = entries.filter((e) => e !== featured).slice(0, 6);

function countLabel(slug: string) {
  const nEntries = entries.filter((e) => e.track === slug).length;
  const nProjects = projects.filter((p) => p.track === slug).length;
  return [nEntries && `${nEntries} bài`, nProjects && `${nProjects} project`].filter(Boolean).join(' • ') || 'Chưa có bài';
}
---
<Base wide>
  <h1 class="sr-only">{site.title}</h1>
  <p class="home-intro">{site.tagline}</p>

  <div class="home">
    <div class="home-main">
      {featured && (
        <section class="home-section home-featured">
          <SectionHead title="Bài nổi bật" />
          <a href={featured.href} tabindex="-1" aria-hidden="true"><Cover entry={featured} fit="contain" /></a>
          <h3><a href={featured.href}>{featured.title}</a></h3>
          <p class="home-subtitle">{featured.subtitle}</p>
          <p class="feed-meta">
            <time datetime={featured.date.toISOString()}>{formatDate(featured.date)}</time> • {getTrack(featured.track).title} • {featured.kind}
          </p>
        </section>
      )}

      {latest.length > 0 && (
        <section class="home-section">
          <SectionHead title="Mới đăng" />
          {latest.map((e) => (
            <article class="feed-item">
              <div class="feed-text">
                <h3><a href={e.href}>{e.title}</a></h3>
                <p class="feed-subtitle">{e.subtitle}</p>
                <p class="feed-meta">
                  <time datetime={e.date.toISOString()}>{formatDate(e.date)}</time> • {getTrack(e.track).title} • {e.kind}
                </p>
              </div>
            </article>
          ))}
          <a class="see-all" href="/archive">Xem tất cả bài viết ›</a>
        </section>
      )}
    </div>

    <aside class="home-side">
      <section class="home-section">
        <div class="side-head">
          <h2>Các mục</h2>
          <a href="/muc">Xem tất cả</a>
        </div>
        <ul class="side-tracks">
          {levelTracks.map((t, i) => (
            <li>
              <a href={`/${t.slug}`}>
                <span class="side-text">
                  <strong>{t.title}</strong>
                  <span class="feed-meta">Level {i + 1} • {countLabel(t.slug)}</span>
                </span>
                <span class="side-badge" style={`--i:${i};`}>{i + 1}</span>
              </a>
            </li>
          ))}
          {extraTracks.map((t) => (
            <li>
              <a href={`/${t.slug}`}>
                <span class="side-text">
                  <strong>{t.title}</strong>
                  <span class="feed-meta">Học thêm • {countLabel(t.slug)}</span>
                </span>
                <span class="side-badge side-badge-extra">+</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-section">
        <div class="side-head">
          <h2>Project</h2>
          <a href="/projects">Xem tất cả</a>
        </div>
        <ul class="side-projects">
          {projects.map((p) => <li><a href={p.links[0]?.href ?? '/projects'}>{p.title}</a></li>)}
        </ul>
      </section>
    </aside>
  </div>

  {site.openToWork && (
    <section class="card">
      <h2>Open to work</h2>
      <p>Mình đang tìm cơ hội ở vị trí data. Xem <a href="/projects">các project</a> hoặc <a href="/about">liên hệ với mình</a>.</p>
    </section>
  )}
</Base>
