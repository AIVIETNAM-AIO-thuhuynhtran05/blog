---
import Base from '../layouts/Base.astro';
import Feed from '../components/Feed.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import TrackPills from '../components/TrackPills.astro';
import { levelTracks, projects, tracks } from '../data/learning';
import { getEntries } from '../lib/content';

export function getStaticPaths() {
  return tracks.map((track) => ({
    params: { track: track.slug },
    props: { track, level: levelTracks.findIndex((t) => t.slug === track.slug) + 1 },
  }));
}

const { track, level } = Astro.props;
const entries = (await getEntries()).filter((e) => e.track === track.slug);
const trackProjects = projects.filter((p) => p.track === track.slug);
---
<Base title={track.title} description={track.summary}>
  <header class="page-head">
    {level > 0 && <p class="stair-level">Level {level}/{levelTracks.length}</p>}
    <h1>{track.title}</h1>
    <p>{track.summary}</p>
  </header>

  <TrackPills />
  <Feed entries={entries} />

  {trackProjects.length > 0 && (
    <section class="track-projects">
      <SectionHead title="Project" />
      {trackProjects.map((p) => <ProjectCard project={p} />)}
    </section>
  )}

  {!entries.length && !trackProjects.length && <p class="empty">Mục này chưa có bài.</p>}
</Base>
