---
import Base from '../layouts/Base.astro';
import Feed from '../components/Feed.astro';
import { bookTrack, trackIntros } from '../data/learning';
import { getEntries } from '../lib/content';

const entries = (await getEntries()).filter((e) => e.track === bookTrack.slug);
const intro = trackIntros[bookTrack.slug];
---
<Base title={bookTrack.title} description={bookTrack.summary}>
  <header class="page-head">
    <h1>{bookTrack.title}</h1>
  </header>

  {intro && <div class="prose track-intro">{intro.map((p) => <p>{p}</p>)}</div>}

  {entries.length > 0 && <Feed entries={entries} />}
</Base>
